# =============================================================================
# JobPilot AI / JobSpy — Environment Variables Template
# =============================================================================
# Copie este arquivo para .env.local para desenvolvimento local:
#   cp .env.example .env.local
#
# Para produção na Vercel:
#   Adicione estas variáveis em: Vercel Dashboard -> Project Settings -> Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Provedores de IA (Pelo menos um é recomendado para o filtro de vagas)
# -----------------------------------------------------------------------------
# Google Gemini (Necessário para a automação diária do cron em /api/cron)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud (Opcional - suporte a modelos ultra-rápidos como openai/gpt-oss-20b)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek (Opcional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI (Opcional)
OPENAI_API_KEY=your_openai_api_key_here

# Together AI (Opcional)
TOGETHER_API_KEY=your_together_api_key_here


# -----------------------------------------------------------------------------
# 2. Autenticação (NextAuth.js)
# -----------------------------------------------------------------------------
# URL base da aplicação:
# Local: http://localhost:3000
# Produção: https://jobspy-automation.vercel.app
NEXTAUTH_URL=https://jobspy-automation.vercel.app

# Chave secreta para criptografia de tokens e sessões (gere com `openssl rand -base64 32`)
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth (Obtenha no Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret


# -----------------------------------------------------------------------------
# 3. Armazenamento em Nuvem (Vercel KV / Upstash Redis)
# -----------------------------------------------------------------------------
# Usado para persistir vagas salvas, agendamentos e preferências por usuário
KV_REST_API_URL=https://your-kv-db.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token_here


# -----------------------------------------------------------------------------
# 4. Agendador em Nuvem (Upstash QStash)
# -----------------------------------------------------------------------------
# Usado para orquestrar execuções agendadas de scraping e filtros
QSTASH_TOKEN=your_qstash_token_here
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key


# -----------------------------------------------------------------------------
# 5. Candidatura Automática via Browser-Use Cloud (Opcional)
# -----------------------------------------------------------------------------
# Credenciais da plataforma Browser-Use (https://browser-use.com)
BROWSER_USE_API_KEY=your_browser_use_api_key_here
BROWSER_PROFILE_ID=your_browser_profile_id_here


# -----------------------------------------------------------------------------
# 6. Proteção do Endpoint de Cron
# -----------------------------------------------------------------------------
# Token para proteger GET /api/cron contra disparos públicos não autorizados
CRON_SECRET=your_secure_cron_secret_here
